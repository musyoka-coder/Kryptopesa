# Browser-safe publishable/anon key only. Never use a service-role key.
# Also used by the read-only Go API to preserve caller RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
LISTEN_ADDR=127.0.0.1:8080
# Optional local-only verification inputs. Never expose these in frontend builds.
# Short-lived test-user token for npm run verify:production (export explicitly):
KP_SMOKE_ACCESS_TOKEN=
# Dedicated staging database only for manually executed SQL regression tests:
TEST_DATABASE_URL=
