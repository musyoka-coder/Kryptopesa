# Browser-safe publishable/anon key only. Never use a service-role key.
# Also used by the read-only Go API to preserve caller RLS.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
LISTEN_ADDR=127.0.0.1:8080

# Optional read-only production verification. Use a dedicated test account token.
# Shell/CI only; never add this to public configuration or commit a value.
KP_SMOKE_ACCESS_TOKEN=
# Optional database regression tests: isolated test database/account only.
TEST_DATABASE_URL=
TEST_USER_ID=
